# ==============================================================================
# Das PG Management — .gitignore
# Tech Stack: React, TypeScript, Vite, Tailwind CSS, Node.js/npm, PWA, Supabase
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*

# ------------------------------------------------------------------------------
# 2. Build Outputs & TypeScript Artifacts
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
coverage/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Environment Variables, Credentials & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
!.env.example

# Keys, certificates, tokens & credential files
*.pem
*.key
*.p12
*.pfx
*.crt
*.secret
*credentials*.json
*service-account*.json
supabase/.env
supabase/.temp/
supabase/.branches/

# ------------------------------------------------------------------------------
# 4. IDE & Editor Files
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. Operating System Files (Windows & macOS)
# ------------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
*.tmp
*.temp
*.bak

# ------------------------------------------------------------------------------
# 7. Local Databases, Backups, Tenant Data & Financial Exports (PII Protection)
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
!supabase/schema.sql

# Exported Das PG backups, reports, tenant lists, and payment records
das-pg-backup-*.json
*backup*.json
backups/
exports/
private-data/
tenants*.json
payments*.json
bills*.json
expenses*.json
*.csv
*.xlsx
*.xls

# ------------------------------------------------------------------------------
# 8. Testing & Cache Files
# ------------------------------------------------------------------------------
.vite/
.cache/
.eslintcache
.stylelintcache
.vitest/
.jest/
test-results/
playwright-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# 9. Generated PWA Build Artifacts (Recreated via `npm run build` / `vite`)
# ------------------------------------------------------------------------------
dev-dist/
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/manifest.webmanifest
